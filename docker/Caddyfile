# HTTPS in front of the site (the `caddy` service in docker-compose.yml, on when
# DOMAIN is set in .env). Caddy gets and renews a Let's Encrypt certificate for
# DOMAIN by itself -- which needs DOMAIN's A record pointing here and inbound
# TCP 80 and 443 open -- and redirects http:// to https://.
#
# It passes everything to nginx (diplomacy_web), setting X-Forwarded-For to
# the client's address (Caddy ignores one a client sends) and
# X-Forwarded-Proto to https; nginx trusts those only from a Docker network
# address (docker/web-nginx.conf.template).
{$DOMAIN} {
	encode zstd gzip

	# Browser hardening for the whole site. The SPA (frontend/dist) has no
	# inline scripts and loads nothing from other origins, so scripts are
	# 'self' only; styles need 'unsafe-inline' because Radix UI and the toast
	# library insert <style> elements at runtime. HSTS without
	# includeSubDomains: other names under the domain are not ours to force.
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
		-Via
	}

	reverse_proxy diplomacy_web:80
}
