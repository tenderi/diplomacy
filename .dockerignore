# Build context is the repository root. Keep the images small and, more to the
# point, keep secrets and local state out of them.
.git
.gitignore
.env
.env.*
venv/
*venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
coverage.xml
tests/
test_maps/
examples/
docs/
infra/
frontend/node_modules/
frontend/dist/
bot_data/
*.sqlite3*
diplomacy.db
*.log
*.md
install.sh
ensure_env.sh
backup.sh
upgrade.sh
setup_database.sh
install_prerequisites.sh
