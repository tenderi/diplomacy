# The development and CI environment: the API's runtime plus tests and checks.
# Compiled with hashes into requirements.txt, at the API's versions (-c).
#
# Every .txt lock is generated; edit the .in files, then from the repository root
# (pip-tools, under Python 3.14):
#   pip-compile --generate-hashes --allow-unsafe --strip-extras -o requirements-api.txt requirements-api.in
#   pip-compile --generate-hashes --allow-unsafe --strip-extras -o requirements-bot.txt requirements-bot.in
#   pip-compile --generate-hashes --allow-unsafe --strip-extras -o requirements.txt requirements.in
#   pip-compile --generate-hashes --allow-unsafe --strip-extras -o docker/docs-requirements.txt docker/docs-requirements.in
# Dependabot keeps them current. pip then refuses anything whose hash differs.
-r requirements-api.in
-c requirements-api.txt
