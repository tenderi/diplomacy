[run]
# Coverage configuration for Diplomacy project. CI collects with `--cov=src` (the
# whole package: engine, server, persistence, rendering), which is the scope below.
source = src
omit = 
    */tests/*
    */test_*
    */__pycache__/*
    */migrations/*
    */alembic/*
    */venv/*
    */env/*
    */.*
    setup.py
    conftest.py

# Branch coverage
branch = True

# Data file location
data_file = .coverage

[report]
# Coverage report settings
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__
    if self\.debug

    # Don't complain if tests don't hit defensive assertion code:
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run:
    if 0:
    if __name__ == .__main__.:

    # Don't complain about abstract methods, they aren't run:
    @(abc\.)?abstractmethod

    # Defensive optional dependency (tested by presence of bcrypt in env):
    except ImportError

# Minimum coverage threshold. This is the overall floor; CI enforces it plus a
# tighter engine-only floor via `coverage report --include='src/engine/*'
# --fail-under=92` (see .github/workflows/test.yml).
#
# Measured 2026-07-28 (v2.7.23 + PR6): engine 92.86%, overall 62.02%.
#
# Overall ratcheted 57 -> 60. It rose from ~59 to 62 because PR4 and Track B's V2
# deleted a lot of untested/dead src code; 60 locks in most of that gain while leaving
# room for CI-environment variance and for V3's rendering split.
#
# The ENGINE floor deliberately stays at 92, NOT ratcheted to ~92.8. V2 deleted 366
# well-tested lines from src/engine/ (province_mapping.py), which dropped the measured
# figure 92.97% -> 92.86% without a single test being lost. Only 0.86 points of headroom
# remain, and tightening further would make ordinary dead-code deletion fail CI --
# exactly the cleanup this project keeps wanting to do. Raise it only alongside genuinely
# new engine tests.
fail_under = 60

# Show missing lines
show_missing = True

# Precision for percentages
precision = 2

# Skip covered files in report
skip_covered = False

[html]
# HTML report settings
directory = htmlcov
title = Diplomacy Test Coverage Report

[xml]
# XML report settings
output = coverage.xml
