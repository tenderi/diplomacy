# nginx site for the Diplomacy browser client (VPS).
#
# Rendered from this template by the official nginx image's envsubst hook.
# ${DIPLOMACY_API_UPSTREAM} is host:port of the API on the home server, over
# WireGuard (default 10.8.0.2:8000).
# Everything else that starts with $ is an nginx variable and is left alone.

# Resolve the upstream once at start; the tunnel address never changes, and
# a variable in proxy_pass would make nginx try to resolve it per request.
upstream diplomacy_api {
    server ${DIPLOMACY_API_UPSTREAM};
    keepalive 8;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Map PNGs are rendered on the home server and can be a few MB.
    client_max_body_size 10M;

    # The container healthcheck (and the upgrade script) hit this; it does
    # not touch the tunnel, so a down home server does not mark nginx unhealthy.
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: /api/<path> -> <upstream>/<path>. The SPA is built with
    # VITE_API_URL=/api. When the home server is unreachable this returns 502
    # and the client shows its error state; nothing to queue on a read path.
    location /api/ {
        proxy_pass http://diplomacy_api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # Hashed build assets: cache hard.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA routes (/games/123 etc.) fall through to index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
