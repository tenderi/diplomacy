# nginx site for the Diplomacy browser client.
#
# Rendered from this template by the official nginx image's envsubst hook.
# ${DIPLOMACY_API_UPSTREAM} is host:port of the API (default diplomacy_api:8000,
# the compose service on the same Docker network).
# Everything else that starts with $ is an nginx variable and is left alone.

# The scheme the browser used: https when Caddy is in front (it sets the
# header), otherwise nginx's own.
map $http_x_forwarded_proto $diplomacy_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    # Behind Caddy (HTTPS; docker/Caddyfile) every connection comes from Caddy's
    # container, so take the client's address from the X-Forwarded-For Caddy
    # sets -- but only when the peer is on a Docker network, which a client on
    # the internet can't be. Without this every visitor would share Caddy's
    # address in the API's per-IP login and registration rate limits.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;

    # Resolve the API through Docker's DNS per request (cached 10s) rather than
    # once at start: `docker compose up -d` can recreate the API container with
    # a new address while this one keeps running, and a start-time `upstream`
    # would keep proxying to the old one (502 until nginx is restarted).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $diplomacy_api ${DIPLOMACY_API_UPSTREAM};

    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Map PNGs are rendered by the API and can be a few MB.
    client_max_body_size 10M;

    # The container healthcheck (and the upgrade script) hit this; it does
    # not touch the API, so a restarting API does not mark nginx unhealthy.
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: /api/<path> -> <upstream>/<path>. The SPA is built with
    # VITE_API_URL=/api. When the API is down this returns 502 and the client
    # shows its error state; nothing to queue on a read path. With a variable
    # in proxy_pass nginx no longer strips the prefix itself, hence the rewrite.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$diplomacy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace, never append: the API (uvicorn, trusting every proxy) reads
        # the *first* X-Forwarded-For entry, and appending let a client choose
        # it by sending its own header -- and so pick the address its login
        # attempts were rate-limited under.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $diplomacy_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # Hashed build assets: cache hard.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA routes (/games/123 etc.) fall through to index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
