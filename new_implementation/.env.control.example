# CONTROL LAYER (VPS) — used by docker-compose.control.yml
#
# This file holds no database URL, no JWT secret and no admin token. If you
# find yourself adding one, the split has sprung a leak: the VPS is the public
# host and is meant to hold as little as possible.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- The API on the home server, over WireGuard ---
# 10.8.0.2 is the home end of the tunnel the p2p stack already runs.
DIPLOMACY_API_URL=http://10.8.0.2:8000
# host:port form of the same thing, for nginx.
DIPLOMACY_API_UPSTREAM=10.8.0.2:8000
# Must match DIPLOMACY_BOT_SECRET in the home server's .env exactly.
DIPLOMACY_BOT_SECRET=

# --- Web frontend ---
# Where nginx listens. Keep WEB_BIND=127.0.0.1 until a TLS proxy is in front.
WEB_BIND=0.0.0.0
WEB_PORT=80

# --- Poll intervals (seconds) ---
# How often the bot asks the home server for notifications to deliver, and
# how often it retries its own queue of undelivered orders/messages.
DIPLOMACY_NOTIFY_POLL_SECONDS=3
DIPLOMACY_OUTBOX_POLL_SECONDS=5
