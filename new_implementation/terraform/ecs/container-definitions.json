[
  {
    "name": "diplomacy-app",
    "image": "000000000000.dkr.ecr.eu-west-1.amazonaws.com/diplomacy-app:latest",
    "essential": true,
    "portMappings": [
      { "containerPort": 8000, "hostPort": 8000, "protocol": "tcp" }
    ],
    "environment": [
      { "name": "SQLALCHEMY_DATABASE_URL", "value": "postgresql+psycopg2://diplomacy:diplomacy@db.example.invalid:5432/diplomacy" },
      { "name": "DIPLOMACY_API_URL", "value": "http://localhost:8000" },
      { "name": "BOT_ONLY", "value": "true" }
    ],
    "secrets": [
      {
        "name": "TELEGRAM_BOT_TOKEN",
        "valueFrom": "arn:aws:secretsmanager:eu-west-1:000000000000:secret:diplomacy/telegram-bot-token"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/diplomacy-app",
        "awslogs-region": "eu-west-1",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }
] 