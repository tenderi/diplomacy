# The whole stack (docker-compose.yml). ensure_env.sh creates .env from this
# file and fills in every blank secret below; you only ever set the Telegram
# token by hand (or let the deploy workflow write it from the repository
# secret). Keep .env at mode 600.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Generated by ensure_env.sh; leave blank ---
# Changing POSTGRES_PASSWORD after the first start also requires changing the
# role's password inside Postgres.
POSTGRES_PASSWORD=
DIPLOMACY_JWT_SECRET=
DIPLOMACY_ADMIN_TOKEN=
# Sent by the bot as X-Bot-Secret, checked by the API; both read it from here.
DIPLOMACY_BOT_SECRET=

# --- Web frontend ---
# Where nginx listens. WEB_BIND=127.0.0.1 keeps it private until a TLS proxy
# is in front (docs/DEPLOYMENT.md).
WEB_BIND=0.0.0.0
WEB_PORT=80
# Public address of the site, for password-reset links and CORS, e.g.
# http://87.58.144.64 (leave blank to disable reset links).
DIPLOMACY_PASSWORD_RESET_BASE_URL=
DIPLOMACY_CORS_ORIGINS=

# DAIDE listener bind (AI bots over TCP). Loopback unless you mean otherwise.
DAIDE_BIND=127.0.0.1

# --- Off-host backups (backup.sh) ---
# rclone remote:path the nightly dumps are copied to. Default when unset:
# proton:diplomacy-backups (a Proton Drive remote named "proton").
# BACKUP_RCLONE_REMOTE=proton:diplomacy-backups

# --- Bot poll intervals (seconds) ---
DIPLOMACY_NOTIFY_POLL_SECONDS=3
DIPLOMACY_OUTBOX_POLL_SECONDS=5

# --- Optional: outgoing email for password reset ---
DIPLOMACY_SMTP_HOST=
DIPLOMACY_SMTP_PORT=587
DIPLOMACY_SMTP_USE_TLS=1
DIPLOMACY_SMTP_USER=
DIPLOMACY_SMTP_PASSWORD=
DIPLOMACY_SMTP_FROM=

DIPLOMACY_LOG_LEVEL=INFO
