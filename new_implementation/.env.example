# GAME LAYER (home server) — used by docker-compose.yml
#
# There is deliberately no TELEGRAM_BOT_TOKEN here. The API never talks to
# Telegram; the bot on the VPS does, and it holds the token. See
# .env.control.example for that side.

# --- Postgres (the compose-managed instance) ---
# install_home.sh generates this. Changing it after first start requires
# changing the role's password inside Postgres too.
POSTGRES_PASSWORD=

# --- API secrets --- (install_home.sh generates all three)
DIPLOMACY_JWT_SECRET=
DIPLOMACY_ADMIN_TOKEN=
# Shared with the bot. Copy this exact value into the VPS .env.
DIPLOMACY_BOT_SECRET=

# --- Network ---
# This host's WireGuard address; the API is published here and on loopback.
WG_IP=10.8.0.2
# DAIDE listener bind. Loopback by default; set to the LAN address to let
# AI bots on the LAN connect. Never the WireGuard address.
DAIDE_BIND=127.0.0.1

# --- Browser client location (the VPS), for password-reset links ---
DIPLOMACY_PASSWORD_RESET_BASE_URL=http://<VPS_PUBLIC_IP>
DIPLOMACY_CORS_ORIGINS=http://<VPS_PUBLIC_IP>

# --- Optional: outgoing email for password reset ---
DIPLOMACY_SMTP_HOST=
DIPLOMACY_SMTP_PORT=587
DIPLOMACY_SMTP_USE_TLS=1
DIPLOMACY_SMTP_USER=
DIPLOMACY_SMTP_PASSWORD=
DIPLOMACY_SMTP_FROM=

DIPLOMACY_LOG_LEVEL=INFO
